rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "xyujin674@gmail.com");
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidAssessment(data) {
      return data.userId is string &&
             data.textId is string &&
             data.textVersion is string &&
             data.answers is list &&
             data.totalScore is number &&
             data.thinkingLevel is string &&
             data.submittedAt is timestamp &&
             data.demographics is map;
    }

    function isValidAnnotation(data) {
      return data.assessmentId is string &&
             data.userId is string &&
             data.textId is string &&
             data.sentenceId is string &&
             data.textSpan is string &&
             data.problems is list &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Assessments
    match /assessments/{assessmentId} {
      allow read: if isAdmin();
      allow create: if isValidAssessment(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Annotations
    match /annotations/{annotationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidAnnotation(request.resource.data);
      allow update: if (isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid)) &&
                      isValidAnnotation(request.resource.data);
      allow delete: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
