{
  "entities": {
    "Assessment": {
      "title": "Assessment",
      "description": "A critical thinking assessment result.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "textId": { "type": "string" },
        "textVersion": { "type": "string", "enum": ["A", "B", "C"] },
        "annotationCount": { "type": "number" },
        "problemDistribution": { "type": "object" },
        "scores": {
          "type": "object",
          "properties": {
            "L1": { "type": "number" },
            "L2": { "type": "number" },
            "L3": { "type": "number" },
            "L4": { "type": "number" }
          }
        },
        "totalScore": { "type": "number" },
        "thinkingLevel": { "type": "string", "enum": ["Developing", "Proficient", "Advanced"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "demographics": { "$ref": "Demographics" }
      },
      "required": ["userId", "textId", "textVersion", "annotationCount", "problemDistribution", "scores", "totalScore", "thinkingLevel", "submittedAt", "demographics"]
    },
    "Annotation": {
      "title": "Annotation",
      "description": "A single sentence annotation.",
      "type": "object",
      "properties": {
        "assessmentId": { "type": "string" },
        "userId": { "type": "string" },
        "textId": { "type": "string" },
        "sentenceId": { "type": "string" },
        "textSpan": { "type": "string" },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string", "enum": ["EVIDENCE", "LOGIC", "ASSUMPTION", "SCOPE", "MISSING_INFO", "VAGUE"] },
              "reason": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["assessmentId", "userId", "textId", "sentenceId", "textSpan", "problems", "createdAt", "updatedAt"]
    },
    "Demographics": {
      "title": "Demographics",
      "type": "object",
      "properties": {
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "raceEthnicity": { "type": "string" }
      },
      "required": ["age", "gender", "raceEthnicity"]
    },
    "User": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Collection of all assessments."
    },
    "/annotations/{annotationId}": {
      "schema": "Annotation",
      "description": "Collection of all annotations."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    }
  }
}
